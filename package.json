{
  "name": "openwave",
  "version": "0.6.0",
  "description": "Free and open-source music player that streams from YouTube",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.openwave.app",
    "productName": "OpenWave",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Audio"
    }
  }
}
