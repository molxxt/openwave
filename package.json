{
  "name": "openwave",
  "version": "0.9.0",
  "description": "Free and open-source music player that streams from YouTube",
  "main": "src/main.js",
  "license": "MIT",
  "author": "OpenWave contributors",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.openwave.app",
    "productName": "OpenWave",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "artifactName": "OpenWave.${ext}",
    "extraResources": [
      { "from": "build/yt-dlp.exe", "to": "yt-dlp.exe" },
      { "from": "build/yt-dlp-linux", "to": "yt-dlp-linux" }
    ],
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Audio"
    },
    "win": {
      "target": ["portable", "nsis"]
    },
    "portable": {
      "artifactName": "OpenWave-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "OpenWave-Setup.${ext}"
    }
  }
}
